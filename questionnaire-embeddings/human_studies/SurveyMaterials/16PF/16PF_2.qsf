 by myself","2":"3","3":"3","4":"5","5":"4","6":"4","7":"2","8":"4","9":"4","10":"4","11":"4","12":"3","13":"5","14":"4","15":"5","16":"4","17":"4","18":"4","19":"4","20":"4","21":"5","22":"4","23":"4","24":"5","25":"4","26":"5","27":"4","28":"4","29":"4","30":"4","31":"5","32":"5","33":"2","34":"4","35":"4","36":"4","37":"4","38":"5","39":"5","40":"5","41":"4","42":"5","43":"4","44":"4","45":"5","46":"5","47":"4","48":"5","49":"2","50":"5","51":"5","52":"4","53":"5","54":"5","55":"5","56":"4","57":"2","58":"4","59":"5","60":"4","61":"2"},"137":{"1":"I seek quiet","2":"3","3":"3","4":"4","5":"4","6":"3","7":"4","8":"4","9":"4","10":"3","11":"4","12":"3","13":"3","14":"3","15":"4","16":"2","17":"3","18":"4","19":"3","20":"4","21":"3","22":"3","23":"4","24":"5","25":"3","26":"4","27":"3","28":"3","29":"4","30":"4","31":"4","32":"3","33":"4","34":"3","35":"2","36":"3","37":"4","38":"5","39":"4","40":"4","41":"1","42":"5","43":"4","44":"5","45":"4","46":"5","47":"3","48":"5","49":"3","50":"5","51":"5","52":"2","53":"5","54":"5","55":"5","56":"2","57":"2","58":"2","59":"2","60":"3","61":"1"},"138":{"1":"I don't mind eating alone","2":"3","3":"3","4":"5","5":"4","6":"4","7":"4","8":"2","9":"4","10":"4","11":"2","12":"4","13":"5","14":"4","15":"4","16":"2","17":"4","18":"4","19":"2","20":"4","21":"4","22":"4","23":"5","24":"4","25":"3","26":"4","27":"2","28":"4","29":"4","30":"4","31":"4","32":"5","33":"2","34":"2","35":"5","36":"4","37":"4","38":"3","39":"4","40":"5","41":"2","42":"3","43":"4","44":"4","45":"4","46":"5","47":"4","48":"5","49":"2","50":"4","51":"5","52":"4","53":"5","54":"5","55":"5","56":"4","57":"2","58":"4","59":"5","60":"4","61":"1"},"139":{"1":"I enjoy silence","2":"3","3":"3","4":"5","5":"4","6":"4","7":"2","8":"5","9":"4","10":"3","11":"3","12":"3","13":"4","14":"4","15":"5","16":"3","17":"3","18":"4","19":"2","20":"4","21":"5","22":"4","23":"4","24":"5","25":"4","26":"4","27":"4","28":"4","29":"4","30":"2","31":"5","32":"2","33":"2","34":"4","35":"