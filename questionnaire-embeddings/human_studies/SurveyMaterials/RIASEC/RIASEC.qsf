eeth?","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"color: rgb(67, 70, 77); font-family: Arial, Helvetica, sans-serif; font-size: 16px;\">How often do you brush your teeth?<\/span>","DefaultChoices":false,"DataExportTag":"Q6.2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How often do you brush your teeth?","Choices":{"1":{"Display":"Never"},"2":{"Display":"Less than Once a Month"},"3":{"Display":"Once a Month"},"4":{"Display":"2-3 Times a Month"},"5":{"Display":"Once a Week"},"6":{"Display":"2-3 Times a Week"},"7":{"Display":"Daily"},"8":{"Display":"2-3 Times a Day"}},"ChoiceOrder":["1","2","3","4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":4,"QuestionID":"QID79","QuestionText_Unsafe":"<span style=\"color: rgb(67, 70, 77); font-family: Arial, Helvetica, sans-serif; font-size: 16px;\">How often do you brush your teeth?<\/span>"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"How old are you (in years)?","TertiaryAttribute":null,"Payload":{"QuestionText":"How old are you (in years)?","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","PrivateData":false,"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How old are you (in years)?","Randomization":{"Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"18","Max":"120"},"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID13\/ChoiceTextEntryValue","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">How old are you (in years)?<\/span> <span class=\"LeftOpDesc\">Text Response<\/span> <span class=\"OpDesc\">Is Greater Than or Equal to<\/span> <span class=\"RightOpDesc\"> 18 <\/span>","LeftOperand":"q:\/\/QID13\/ChoiceTextEntryValue","LogicType":"Question","Operator":"GreaterThanOrEqual","QuestionID":"QID13","QuestionIDFromLocator":"QID13","QuestionIsInLoop":"no","RightOperand":"18","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Require valid numbers minimum","libraryID":"UR_b1lwVdARkVjPXff","messageID":"MS_3dDV1NU4bu3zSwR","subMessageID":"VE_VALIDMIN_PLURAL"}}}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"How old are you (in years)?","DataExportTag":"Q28.2","QuestionID":"QID13","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"In a few words, please describe your impression of this person. ","TertiaryAttribute":null,"Payload":{"QuestionText":"In a few words, please describe your impression of this person.&nbsp;","DefaultChoices":false,"DataExportTag":"Q27.1","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In a few words, please describe your impression of this person. ","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","ContentType":null,"ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID16","QuestionText_Unsafe":"In a few words, please describe your impression of this person.&nbsp;","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Online Consent \u00a0 This survey is part of a research study conducted by Sudeep Bhatia at the Univer..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<p style=\"text-align: center;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><u><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Online Consent<\/span><\/strong><\/span><\/u><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n<\/div>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/strong><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">This survey is part of a research study conducted by Sudeep Bhatia at the University of Pennsylvania. &nbsp;The purpose of the research is to understand the ways individuals make everyday judgment and decisions<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Procedures<\/span><\/strong><span style=\"letter-spacing: -0.15pt;\">&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">In this study you will be required to answer a set of questions regarding a judgment or hypothetical choice task. The task will relate to everyday judgments and choices. We may ask you a number of questions regarding your judgments and choices prior to your decision, or after your decision. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Participant Requirements<\/span><\/strong><span style=\"letter-spacing: -0.15pt;\">&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">Participation in this study is limited to individuals age 18 and older.&nbsp; Participants need to be fluent in English. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/strong><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Risks<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">The risks and discomfort associated with participation in this study are no greater than those ordinarily encountered in daily life or during other online activities.&nbsp; It is possible that you may experience slight boredom or fatigue from the continual use of a computer. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Benefits<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">There may be no personal benefit from your participation in the study but the knowledge received may be of value to humanity.&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Compensation &amp; Costs<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">You will be paid for participating. Your &nbsp;compensation from this study is described on the Prolific Academic interface.&nbsp;There will be no cost to you if you participate in this study.&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Confidentiality<\/span><\/strong><\/span><\/span><span style=\"mso-bidi-font-size:12.0pt;\nfont-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">The data captured for the research does not include any personally identifiable information about you.&nbsp; Your IP address will not be captured.<\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong>Right to Ask Questions &amp; Contact Information<\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">If you have any questions about this study, you should feel free to ask them by contacting the Principal Investigator:<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Sudeep Bhatia<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Department of Psychology<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">University of Pennsylvania<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">3720 Walnut St<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Philadelphia, PA. 19104<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">USA.<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Email: bhatiasu@sas.upenn.edu<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Phone: 215-573-5096<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong>Voluntary Participation<\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Your participation in this research is voluntary.&nbsp; You may discontinue participation at any time during the research activity.&nbsp;&nbsp;<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Please check the following boxes before starting the study:<\/span><\/span><\/p>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","PrivateData":false,"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Online Consent \u00a0 This survey is part of a research study conducted by Sudeep Bhatia at the Univer...","Choices":{"1":{"Display":"I am age 18 or older"},"2":{"Display":"I have read and understand the information above"},"3":{"Display":"I want to participate in this research and continue with the survey"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","MinChoices":"3","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID3","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID3\/SelectedChoicesCount","Operator":"EqualTo","QuestionIDFromLocator":"QID3","LeftOperand":"q:\/\/QID3\/SelectedChoicesCount","RightOperand":"3","IgnoreCase":0,"Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Online Consent &nbsp; This survey is part of a research study conducted by Sudeep Bhatia at the Univer...<\/span> <span class=\"LeftOpDesc\">q:\/\/QID3\/SelectedChoicesCount<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 3 <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_0CUHpWTdGOvcwQJ","subMessageID":"VE_FORCE_RESPONSE_MORE","libraryID":"UR_b1lwVdARkVjPXff","description":"Require all choice responses"}}}},"Language":[],"DataVisibility":{"Private":false},"QuestionText_Unsafe":"<div>\n<p style=\"text-align: center;\"><span style=\"font-family:arial,helvetica,sans-serif;\"><u><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Online Consent<\/span><\/strong><\/span><\/u><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n<\/div>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/strong><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">This survey is part of a research study conducted by Sudeep Bhatia at the University of Pennsylvania. &nbsp;The purpose of the research is to understand the ways individuals make everyday judgment and decisions<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Procedures<\/span><\/strong><span style=\"letter-spacing: -0.15pt;\">&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">In this study you will be required to answer a set of questions regarding a judgment or hypothetical choice task. The task will relate to everyday judgments and choices. We may ask you a number of questions regarding your judgments and choices prior to your decision, or after your decision. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Participant Requirements<\/span><\/strong><span style=\"letter-spacing: -0.15pt;\">&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">Participation in this study is limited to individuals age 18 and older.&nbsp; Participants need to be fluent in English. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/strong><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Risks<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">The risks and discomfort associated with participation in this study are no greater than those ordinarily encountered in daily life or during other online activities.&nbsp; It is possible that you may experience slight boredom or fatigue from the continual use of a computer. <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Benefits<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">There may be no personal benefit from your participation in the study but the knowledge received may be of value to humanity.&nbsp; <\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Compensation &amp; Costs<\/span><\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">You will be paid for participating. Your &nbsp;compensation from this study is described on the Prolific Academic interface.&nbsp;There will be no cost to you if you participate in this study.&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong><span style=\"letter-spacing: -0.15pt;\">Confidentiality<\/span><\/strong><\/span><\/span><span style=\"mso-bidi-font-size:12.0pt;\nfont-family:&quot;Calibri&quot;,sans-serif;letter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">The data captured for the research does not include any personally identifiable information about you.&nbsp; Your IP address will not be captured.<\/span><\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;\nletter-spacing:-.15pt\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><span style=\"letter-spacing: -0.15pt;\">&nbsp;<\/span><\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong>Right to Ask Questions &amp; Contact Information<\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">If you have any questions about this study, you should feel free to ask them by contacting the Principal Investigator:<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Sudeep Bhatia<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Department of Psychology<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">University of Pennsylvania<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">3720 Walnut St<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Philadelphia, PA. 19104<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">USA.<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Email: bhatiasu@sas.upenn.edu<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Phone: 215-573-5096<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">&nbsp;<\/span><\/span><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\"><strong>Voluntary Participation<\/strong><\/span><\/span><strong><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/strong><\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Your participation in this research is voluntary.&nbsp; You may discontinue participation at any time during the research activity.&nbsp;&nbsp;<\/span><\/span><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><o:p><\/o:p><\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-family:arial,helvetica,sans-serif;\"><span style=\"font-size:13px;\">Please check the following boxes before starting the study:<\/span><\/span><\/p>","DataExportTag":"Q8.1","QuestionID":"QID3"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Please tell us a little about yourself by selecting the option that best describes you. The follo...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please tell us a little about yourself by selecting the option that best describes you. The following information is\nconfidential. Your demographic information will be combined with that\nof other survey respondents to describe the aggregate demographics of our sample.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","PrivateData":false,"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please tell us a little about yourself by selecting the option that best describes you. The follo...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON"}},"Language":[],"QuestionText_Unsafe":"Please tell us a little about yourself by selecting the option that best describes you. The following information is\nconfidential. Your demographic information will be combined with that\nof other survey respondents to describe the aggregate demographics for\nthe sample.","DataExportTag":"Q28.1","QuestionID":"QID12","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Sorry, you failed an attention check question and are no longer eligible for this survey. In case...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><div>Sorry, you failed an attention check question and are no longer eligible for this survey.<br>In case you are wondering why you failed the attention check question, you were supposed to answer the question about family honestly but pick \"never\" for the question about brushing teeth. These instructions were in the sentence:<br>Please answer the question below honestly, but for the question on the next page, pick \"never.\"<\/div><div><br><\/div><div>Please cancel your sign-up for this study. Thank you for your time.<\/div><div><\/div><\/div><div><\/div><div><\/div><div><\/div>","DefaultChoices":false,"DataExportTag":"Q7.1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Sorry, you failed an attention check question and are no longer eligible for this survey. In case...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID81","QuestionText_Unsafe":"<div><div>Sorry, you failed an attention check question and are no longer eligible for this survey.<br>In case you are wondering why you failed the attention check question, you were supposed to answer the question about family honestly but pick \"never\" for the question about brushing teeth. These instructions were in the sentence:<br>Please answer the question below honestly, but for the question on the next page, pick \"never.\"<\/div><div><br><\/div><div>Please cancel your sign-up for this study. Thank you for your time.<\/div><div><\/div><\/div><div><\/div><div><\/div><div><\/div>"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">Welcome.<br>\n<br>\nWe are interested in understanding how people perceive and predict another person's personality. In this study, we will present you a previous participant's responses to a personality survey. We will show you a set of 40 personality survey questions one at a time, with this person's answers on a five point scale, where 1=Disagree, 3=Neutral, to 5=Agree. Based on these answers, you will need to predict how this person responded to 8 other questions on the same scale.<br>\n<br>\nPlease make your best prediction. We will give you an extra $1 if your predictive accuracy achieves the top 10% among all participants.<br>\n<br>\n&nbsp;Please do not restart the study once you begin, as it will invalidate your response.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q1.1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID6","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">We are interested in understanding how people perceive and predict another person's personality. In this study, we will present you a previous participant's responses to a personality survey. We will show you a set of 90 personality survey questions one at a time, with this person's answers on a five point scale, where 1=Disagree, 3=Neutral, to 5=Agree. Based on these answers, you will need to predict how this person responded to 10 other questions on the same scale.&nbsp;<br>\n<br>\nPlease make your best prediction.&nbsp;<\/span><\/span><span style=\"font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 19px;\">We will give you extra $1&nbsp;if your predictive accuracy achieves the top 10% among all participants.&nbsp;<\/span><br><span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">&nbsp;&nbsp;<br>\nPlease do not restart the study once you begin, as it will invalidate your response.<\/span><\/span>","QuestionJS":false}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","PrivateData":false,"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your gender?","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Other"}},"ChoiceOrder":[1,2,3],"Randomization":{"Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionText_Unsafe":"What is your gender?","DataExportTag":"Q28.3","QuestionID":"QID14"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"What is your Prolific ID?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your Prolific ID?","DefaultChoices":{"TEXT":{"Text":"${e:\/\/Field\/PROLIFIC_PID}"}},"QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your Prolific ID?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"What is your Prolific ID?","DataExportTag":"Q8.2","QuestionID":"QID4","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}}]}