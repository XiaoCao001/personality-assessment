ightOpDesc\">Current Loop<\/span>","LeftOperand":"BL_6ij3nirF5upV1qK,47","LogicType":"LoopAndMerge","Operator":"EqualTo","RightOperand":"lm:\/\/CurrentLoop","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span>  <span class=\"LeftOpDesc\">fold<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 4 <\/span>","LeftOperand":"fold","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"4","Type":"Expression"},"Type":"ElseIf"},"47":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\"><\/span> <span class=\"LeftOpDesc\">Loop 48: Keep shipping and receiving rec...<\/span> <span class=\"OpDesc\"><\/span> <span class=\"RightOpDesc\">Current Loop<\/span>","LeftOperand":"BL_6ij3nirF5upV1qK,48","LogicType":"LoopAndMerge","Operator":"EqualTo","RightOperand":"lm:\/\/CurrentLoop","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span>  <span class=\"LeftOpDesc\">fold<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 3 <\/span>","LeftOperand":"fold","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"3","Type":"Expression"},"Type":"ElseIf"},"Type":"BooleanExpression","inPage":false},"DataExportTag":"Q726","QuestionID":"QID726"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"RS","PrimaryAttribute":"RS_6KW6cx4aMighg7s","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Friends and Family \u00a0 Many individuals' happiness depends on their relationship with friends and f..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>\n<div>\n<div>\n<div>\n<div>\n<div style=\"text-align: center;\"><span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\"><u><strong>Friends and Family<\/strong><\/u><\/span><\/span><\/div>\n\n<div><br \/>\n&nbsp;<\/div>\n\n<div><span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\">Many individuals&#39; happiness depends on their relationship with friends and family. According to Wikipedia, Ia&nbsp;<strong>family<\/strong>&nbsp;(from Latin:&nbsp;<em>familia<\/em>) is a group of people affiliated by consanguinity, affinity, or co-residence. In most societies it is the principal institution for the socialization of children.&nbsp;<\/span><\/span><span style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px;\">Please answer the question below honestly, but for the question on the next page, pick &quot;never.&quot; Anthropologists most generally classify family organization as matrilocal (a mother and her children); conjugal (a husband, his wife, and children; also called nuclear family); and consanguineal (also called an extended family) in which parents and children co-reside with other members of one parent&#39;s family.&nbsp;<\/span><\/div>\n\n<div><br \/>\n<br \/>\n<span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\">How many people are in your family?<\/span><\/span><\/div>\n<\/div>\n\n<div>\n<div>&nbsp;<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","DataExportTag":"Q6.1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Friends and Family \u00a0 Many individuals' happiness depends on their relationship with friends and f...","Choices":{"1":{"Display":"0"},"2":{"Display":"1"},"3":{"Display":"2"},"4":{"Display":"3"},"5":{"Display":"4"},"6":{"Display":"5"},"7":{"Display":"6+"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID78","QuestionText_Unsafe":"<div>\n<div>\n<div>\n<div>\n<div>\n<div style=\"text-align: center;\"><span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\"><u><strong>Friends and Family<\/strong><\/u><\/span><\/span><\/div>\n\n<div><br \/>\n&nbsp;<\/div>\n\n<div><span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\">Many individuals&#39; happiness depends on their relationship with friends and family. According to Wikipedia, Ia&nbsp;<strong>family<\/strong>&nbsp;(from Latin:&nbsp;<em>familia<\/em>) is a group of people affiliated by consanguinity, affinity, or co-residence. In most societies it is the principal institution for the socialization of children.&nbsp;<\/span><\/span><span style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px;\">Please answer the question below honestly, but for the question on the next page, pick &quot;never.&quot; Anthropologists most generally classify family organization as matrilocal (a mother and her children); conjugal (a husband, his wife, and children; also called nuclear family); and consanguineal (also called an extended family) in which parents and children co-reside with other members of one parent&#39;s family.&nbsp;<\/span><\/div>\n\n<div><br \/>\n<br \/>\n<span style=\"font-size: 16px;\"><span style=\"font-family: Arial, Helvetica, sans-serif;\">How many people are in your family?<\/span><\/span><\/div>\n<\/div>\n\n<div>\n<div>&nbsp;<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>"}},{"SurveyID":"SV_1S5UkOuK1svQBj8","Element":"SQ","PrimaryAttribute":"QID596","SecondaryAttribute":"How did this person respond to the following question?","TertiaryAttribute":null,"Payload":{"QuestionText":"How did this person respond to the following question?","QuestionJS":false,"DefaultChoices":false,"DataExportTag":"Q589","QuestionID":"QID596","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":