":"40","41":"40","42":"20","43":"20","44":"40","45":"30","46":"20","47":"20","48":"30","49":"40","50":"40","51":"30","52":"30","53":"40","54":"20","55":"10","56":"10","57":"40","58":"10","59":"10","60":"20","61":"40"},"5":{"1":"I don\u2019t have to work very hard at making other people laugh\u2014i seem to be a naturally humorous person.","2":"40","3":"20","4":"20","5":"40","6":"20","7":"10","8":"10","9":"40","10":"30","11":"30","12":"40","13":"50","14":"10","15":"30","16":"40","17":"40","18":"20","19":"30","20":"50","21":"50","22":"30","23":"30","24":"40","25":"50","26":"50","27":"50","28":"20","29":"40","30":"40","31":"40","32":"20","33":"20","34":"40","35":"40","36":"20","37":"30","38":"30","39":"20","40":"30","41":"30","42":"50","43":"50","44":"50","45":"40","46":"40","47":"40","48":"40","49":"30","50":"40","51":"50","52":"50","53":"40","54":"50","55":"10","56":"50","57":"40","58":"40","59":"30","60":"40","61":"50"},"6":{"1":"Even when i\u2019m by myself, i\u2019m often amused by the absurdities of life.","2":"50","3":"10","4":"40","5":"40","6":"40","7":"30","8":"10","9":"30","10":"50","11":"30","12":"40","13":"50","14":"30","15":"40","16":"40","17":"40","18":"50","19":"40","20":"50","21":"30","22":"30","23":"50","24":"50","25":"50","26":"10","27":"50","28":"30","29":"40","30":"40","31":"50","32":"30","33":"50","34":"50","35":"50","36":"30","37":"40","38":"50","39":"50","40":"40","41":"50","42":"40","43":"40","44":"50","45":"50","46":"50","47":"40","48":"50","49":"40","50":"50","51":"50","52":"50","53":"40","54":"50","55":"40","56":"50","57":"40","58":"50","59":"50","60":"50","61":"50"},"7":{"1":"People are never offended or hurt by my sense of humor.","2":"30","3":"40","4":"30","5":"30","6":"40","7":"20","8":"10","9":"40","10":"30","11":"40","12":"30","13":"40","14":"10","15":"30","16":"30","17":"30","18":"20","19":"20","20":"30","21":"40","22":"20","23":"20","24":"30","25":"30","26":"50","27":"10","28":"50","29":"20","30":"40","31":"10","32":"20","33":"40","34":"40","35":"40","36":"50","37":"50","38":"30","39":"10","40":"30","41":"20","42":"40","43":"10","44":"40","45":"10","46":"40","47":"40","48":"40","49":"30","50":"10","51":"40","52":"50","53":"50","54":"30","55":"40","56":"20","57":"20","58":"30","59":"30","60":"40","61":"40"},"8":{"1":"I will often get carried away in putting myself down if it makes my family or friends laugh.","2":"20","3":"20","4":"30","5":"20","6":"50","7":"30","8":"10","9":"20","10":"20","11":"30","12":"20","13":"30","14":"10","15":"20","16":"40","17":"10","18":"20","19":"10","20":"30","21":"40","22":"30","23":"10","24":"40","25":"10","26":"10","27":"30","28":"40","29":"30","30":"30","31":"10","32":"20","33":"10","34":"10","35":"20","36":"10","37":"30","38":"20","39":"30","40":"40","41":"20","42":"40","43":"30","44":"30","45":"20","46":"40","47":"10","48":"20","49":"50","50":"40","51":"20","52":"30","53":"40","54":"30","55":"10","56":"40","57":"40","58":"10","59":"10","60":"20","61":"50"},"9":{"1":"I rarely make other people laugh by telling funny stories about myself.","2":"50","3":"50","4":"40","5":"30","6":"20","7":"40","8":"10","9":"20","10":"30","11":"20","12":"30","13":"20","14":"50","15":"30","16":"30","17":"40","18":"40","19":"30","20":"20","21":"20","22":"40","23":"40","24":"20","25":"10","26":"10","27":"30","28":"40","29":"10","30":"40","31":"50","32":"40","33":"50","34":"30","35":"30","36":"30","37":"40","38":"40","39":"20","40":"10","41":"20","42":"20","43":"20","44":"20","45":"20","46":"30","47":"20","48":"20","49":"20","50":"20","51":"20","52":"10","53":"20","54":"10","55":"50","56":"10","57":"20","58":"30","59":"40","60":"20","61":"10"},"10":{"1":"If i am feeling upset or unhappy i usually try to think of something funny about the situation to make myself feel better.","2":"10","3":"10","4":"40","5":"10","6":"30","7":"20","8":"10","9":"20","10":"30","11":"20","12":"20","13":"40","14":"10","15":"40","16":"30","17":"20","18":"20","19":"30","20":"10","21":"20","22":"30","23":"20","2