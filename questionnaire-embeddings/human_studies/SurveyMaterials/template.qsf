:"50","15":"40","16":"40","17":"50","18":"50","19":"30","20":"50","21":"50","22":"50","23":"40","24":"50","25":"50","26":"50","27":"40","28":"50","29":"50","30":"50","31":"50","32":"40","33":"50","34":"50","35":"50","36":"50","37":"30","38":"40","39":"40","40":"50","41":"50","42":"50","43":"50","44":"50","45":"50","46":"50","47":"50","48":"40","49":"40","50":"50","51":"50","52":"50","53":"40","54":"50","55":"10","56":"50","57":"40","58":"50","59":"10","60":"50","61":"50"},"14":{"1":"My humorous outlook on life keeps me from getting overly upset or depressed about things.","2":"30","3":"10","4":"30","5":"40","6":"50","7":"20","8":"10","9":"20","10":"30","11":"30","12":"30","13":"30","14":"30","15":"40","16":"40","17":"20","18":"40","19":"30","20":"20","21":"50","22":"30","23":"20","24":"40","25":"30","26":"10","27":"20","28":"20","29":"30","30":"30","31":"30","32":"30","33":"10","34":"20","35":"50","36":"30","37":"30","38":"30","39":"40","40":"20","41":"40","42":"40","43":"40","44":"30","45":"30","46":"30","47":"30","48":"30","49":"20","50":"50","51":"40","52":"50","53":"40","54":"40","55":"40","56":"50","57":"50","58":"50","59":"10","60":"40","61":"50"},"15":{"1":"I do not like it when people use humor as a way of criticizing or putting someone down.","2":"40","3":"10","4":"20","5":"10","6":"40","7":"10","8":"10","9":"40","10":"30","11":"40","12":"50","13":"30","14":"10","15":"50","16":"30","17":"40","18":"20","19":"20","20":"20","21":"30","22":"50","23":"20","24":"30","25":"30","26":"40","27":"20","28":"30","29":"50","30":"50","31":"50","32":"20","33":"50","34":"50","35":"20","36":"30","37":"50","38":"20","39":"50","40":"30","41":"40","42":"40","43":"10","44":"30","45":"20","46":"30","47":"20","48":"20","49":"40","50":"20","51":"10","52":"50","53":"50","54":"30","55":"50","56":"10","57":"20","58":"20","59":"50","60":"40","61":"10"},"16":{"1":"I don\u2019t often say funny things to put myself down.","2":"20","3":"30","4":"30","5":"40","6":"30","7":"30","8":"10","9":