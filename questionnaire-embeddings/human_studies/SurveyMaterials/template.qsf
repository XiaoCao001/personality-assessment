Description":"<span class=\"ConjDesc\">If<\/span><span> False<\/span>","LogicType":"BooleanValue","Type":"Expression","Value":"False"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionText_Unsafe":"randomly choose one target (hidden from participants)"}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Sorry, you failed an attention check question and are no longer eligible for this survey. In case...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><div>Sorry, you failed an attention check question and are no longer eligible for this survey.<br>In case you are wondering why you failed the attention check question, you were supposed to answer the question about family honestly but pick \"never\" for the question about brushing teeth. These instructions were in the sentence:<br>Please answer the question below honestly, but for the question on the next page, pick \"never.\"<\/div><div><br><\/div><div>Please cancel your sign-up for this study. Thank you for your time.<\/div><div><\/div><\/div><div><\/div><div><\/div><div><\/div>","DefaultChoices":false,"DataExportTag":"Q7.1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Sorry, you failed an attention check question and are no longer eligible for this survey. In case...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID81","QuestionText_Unsafe":"<div><div>Sorry, you failed an attention check question and are no longer eligible for this survey.<br>In case you are wondering why you failed the attention check question, you were supposed to answer the question about family honestly but pick \"never\" for the question about brushing teeth. These instructions were in the sentence:<br>Please answer the question below honestly, but for the question on the next page, pick \"never.\"<\/div><div><br><\/div><div>Please cancel your sign-up for this study. Thank you for your time.<\/div><div><\/div><\/div><div><\/div><div><\/div><div><\/div>"}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID657","SecondaryAttribute":"Target: ${e:\/\/Field\/target}\u00a0 Fold:\u00a0${e:\/\/Field\/fold}","TertiaryAttribute":null,"Payload":{"QuestionText":"Target: ${e:\/\/Field\/target}&nbsp;<br>Fold:&nbsp;${e:\/\/Field\/fold}<br>","DefaultChoices":false,"DataExportTag":"Q74","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Target: ${e:\/\/Field\/target}\u00a0 Fold:\u00a0${e:\/\/Field\/fold}","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID657"}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">Welcome.<br>\n<br>\nWe are interested in understanding how people perceive and predict another person's personality. In this study, we will present you a previous participant's responses to a personality survey. We will show you a set of 28-29 personality survey questions one at a time, with this person's answers on a five point scale, where 1=Disagree, 3=Neutral, to 5=Agree. Based on these answers, you will need to predict how this person responded to 3-4 other questions on the same scale.<br>\n<br>\nPlease make your best prediction. We will give you an extra $1 if your predictive accuracy achieves the top 10% among all participants.<br>\n<br>\n&nbsp;Please do not restart the study once you begin, as it will invalidate your response.<\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q1.1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID6","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">We are interested in understanding how people perceive and predict another person's personality. In this study, we will present you a previous participant's responses to a personality survey. We will show you a set of 90 personality survey questions one at a time, with this person's answers on a five point scale, where 1=Disagree, 3=Neutral, to 5=Agree. Based on these answers, you will need to predict how this person responded to 10 other questions on the same scale.&nbsp;<br>\n<br>\nPlease make your best prediction.&nbsp;<\/span><\/span><span style=\"font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 19px;\">We will give you extra $1&nbsp;if your predictive accuracy achieves the top 10% among all participants.&nbsp;<\/span><br><span style=\"font-size:19px;\"><span style=\"font-family:Times New Roman,Times,serif;\">&nbsp;&nbsp;<br>\nPlease do not restart the study once you begin, as it will invalidate your response.<\/span><\/span>","QuestionJS":false}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID656","SecondaryAttribute":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Welcome. <br><\/div><div><br><\/div><div>We are interested in understanding how people perceive and predict another person's personality. In this study, we will present you a previous participant's responses to a personality survey. We will show you a set of 90 personality survey questions one at a time, with this person's answers on a five point scale, where 1=Disagree, 3=Neutral, to 5=Agree. Based on these answers, you will need to predict how this person responded to 10 other questions on the same scale. <br><\/div><div><br><\/div><div>Please make your best prediction. We will give you extra $1 if your predictive accuracy achieves the top 10% among all participants.<\/div><div><br><\/div><div>&nbsp;Please do not restart the study once you begin, as it will invalidate your response.<\/div>","DefaultChoices":false,"DataExportTag":"Q73","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome. We are interested in understanding how people perceive and predict another person's pers...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID656","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","PrivateData":false,"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your gender?","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Other"}},"ChoiceOrder":[1,2,3],"Randomization":{"Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionText_Unsafe":"What is your gender?","DataExportTag":"Q28.3","QuestionID":"QID14"}},{"SurveyID":"SV_exEWMv9zTJbgAES","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"What is your Prolific ID?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your Prolific ID?","DefaultChoices":{"TEXT":{"Text":"${e:\/\/Field\/PROLIFIC_PID}"}},"QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your Prolific ID?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"What is your Prolific ID?","DataExportTag":"Q8.2","QuestionID":"QID4","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}}]}