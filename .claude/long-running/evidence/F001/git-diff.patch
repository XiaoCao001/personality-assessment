+#!/usr/bin/env python3
+"""
+Validation script for F001 outputs.
+
+Checks that Y.npy, E_old.npy, and metadata.parquet exist and are valid.
+
+Usage:
+    python scripts/validate_data.py
+"""
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+PROJECT_ROOT = Path(__file__).resolve().parent.parent
+DATA_DIR = PROJECT_ROOT / "data" / "processed"
+
+
+def main():
+    errors = []
+
+    # Check files exist
+    for fname in ["Y.npy", "E_old.npy", "metadata.parquet"]:
+        fp = DATA_DIR / fname
+        if not fp.exists():
+            errors.append(f"Missing file: {fp}")
+            print(f"[FAIL] {fp} not found")
+
+    if errors:
+        print("\n".join(errors))
+        return 1
+
+    # Load and validate Y
+    Y = np.load(DATA_DIR / "Y.npy")
+    print(f"Y.npy: shape={Y.shape}, dtype={Y.dtype}, range=[{Y.min():.0f}, {Y.max():.0f}]")
+    assert Y.shape == (2749, 100), f"Y shape {Y.shape} != (2749, 100)"
+    assert Y.min() >= 1 and Y.max() <= 5, "Y values out of [1,5]"
+    assert not np.any(np.isnan(Y)), "Y contains NaN"
+    print("[PASS] Y matrix ✓")
+
+    # Load and validate E_old
+    E = np.load(DATA_DIR / "E_old.npy")
+    print(f"E_old.npy: shape={E.shape}, dtype={E.dtype}")
+    assert E.shape[0] == 100, f"E_old rows {E.shape[0]} != 100"
+    assert E.shape[1] >= 384, f"E_old dim {E.shape[1]} < 384"
+    norms = np.linalg.norm(E, axis=1)
+    assert np.allclose(norms, 1.0, atol=1e-5), f"L2 norms not 1.0: range [{norms.min():.6f}, {norms.max():.6f}]"
+    print("[PASS] E_old matrix ✓")
+
+    # Load and validate metadata
+    meta = pd.read_parquet(DATA_DIR / "metadata.parquet")
+    print(f"metadata.parquet: shape={meta.shape}, columns={list(meta.columns)}")
+    assert len(meta) == 100, f"metadata rows {len(meta)} != 100"
+    assert set(meta["trait_id"].unique()) == {"O", "C", "E", "A", "N"}, "Unexpected traits"
+    trait_counts = meta["trait_id"].value_counts()
+    assert all(v == 20 for v in trait_counts.values), f"Uneven trait distribution: {trait_counts.to_dict()}"
+    print("[PASS] Metadata ✓")
+
+    print("\nAll validations passed.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
